# Postgres connection string for the RevenuePilot database.
DATABASE_URL="postgresql://USER@localhost:5432/revenuepilot?schema=public"

# DEMO_MODE gates seed/reset/simulation affordances that must never be
# available outside the hackathon demo environment.
DEMO_MODE="true"

# Reasoning model. Optional: without it the reasoner uses its deterministic
# fallback and labels the proposal DETERMINISTIC_FALLBACK.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-5"
