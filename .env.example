# Postgres connection string for the RevenuePilot database.
DATABASE_URL="postgresql://USER@localhost:5432/revenuepilot?schema=public"

# DEMO_MODE gates seed/reset/simulation affordances that must never be
# available outside the hackathon demo environment.
DEMO_MODE="true"

# Reasoning model. Optional: with no key the reasoner uses its deterministic
# fallback and labels the proposal DETERMINISTIC_FALLBACK.
#
# Set EITHER provider. "auto" prefers Anthropic, then Groq.
# LLM_PROVIDER="auto"        # auto | anthropic | groq | none

# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-5"

# Groq serves open models behind an OpenAI-compatible API. Model ids change --
# confirm against Groq's current model list if you get an unknown-model error.
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="llama-3.3-70b-versatile"
